{
  "name": "hackathon3-lobby",
  "servePort": 34873,
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": { "$path": "src/shared" }
    },
    "ServerScriptService": {
      "$ignoreUnknownInstances": false,
      "Lobby": { "$path": "src/lobby/server" },
      "Common": { "$path": "src/common/server" }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "$ignoreUnknownInstances": false,
        "Lobby": { "$path": "src/lobby/client" }
      }
    }
  }
}
